[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
[remote "origin"]
	url = https://github.com/Yugamtech-projects/Proxima.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "temp"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/temp
